# Competition inputs are never committed: the official data page requires participant access and redistribution terms are unverified.
# Restore from the hash-pinned owner mirror with scripts/download_competition_data.sh; never commit source rasters.
data/raw/
data/interim/
data/external/
data/grid/
data/bridge/
data/pilot/
# Rasters and model outputs are kept out of Git (use external storage if they must be shared).
*.tif
*.tiff
*.npy
*.npz
*.zip
# The lane's own published deliverables are hosted on Pages: predictions and receipts, never organizer data.
!docs/downloads/*.tif
!docs/downloads/*.zip
!evidence/*.npz
!evidence/*.json.gz
# Python / tooling
__pycache__/
.pytest_cache/
.venv/
*.pyc
