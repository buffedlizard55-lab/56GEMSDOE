# Local competition data and derived rasters stay out of Git. Keep the data README and only the three small,
# sha256-pinned compatibility bridge files below under data/.
/data/*
!/data/README.md
!/data/bridge/
/data/bridge/*
!/data/bridge/manifest.json

# Rasters, model outputs and archives are ignored globally.
*.tif
*.tiff
*.npy
*.npz
*.zip

# Public, pinned bridge inputs (allow these exact small files after the global raster rule).
!/data/bridge/example_submission.tif
!/data/bridge/existing_faults.tif

# Published candidate artifacts are deliberately retained for audit on Pages.
!docs/downloads/*.tif
!docs/downloads/*.zip
!evidence/*.npz
!evidence/*.json.gz

# Python/tooling
__pycache__/
.pytest_cache/
.venv/
venv/
*.pyc
_pr_body.md
_venv.log

# Holdout/intermediate data and local logs
/data/cache/
/data/reconstructed/
/data/raw/
/data/interim/
/data/external/
/data/grid/
/data/_screen.log
/data/_lane_gate.log
